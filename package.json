{
  "name": "dcs-map-server",
  "version": "0.4319.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:client": "esbuild src/client/main.ts --bundle --format=esm --sourcemap --outfile=public/main.js",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "dev": "npm run build && node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build:test --silent && npm run build:server --silent && node --test \"dist-test/test/**/*.test.js\"",
    "build:test": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "build:tools": "tsc -p tsconfig.tools.json",
    "telemetry": "npm run build:tools --silent && node dist-tools/tools/generate-telemetry.js",
    "acmi": "npm run build:tools --silent && node dist-tools/tools/acmi-to-telemetry.js",
    "capture": "npm run build:tools --silent && node dist-tools/tools/inspect-capture.js",
    "capture-ws": "npm run build:tools --silent && node dist-tools/tools/capture-ws.js",
    "replay-ws": "npm run build:tools --silent && node dist-tools/tools/replay-ws.js",
    "fetch-assets": "npm run build:tools --silent && node dist-tools/tools/fetch-map-assets.js",
    "fetch-tiles": "npm run build:tools --silent && node dist-tools/tools/fetch-tiles.js",
    "install-hook": "npm run build:tools --silent && node dist-tools/tools/install-hook.js"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@protomaps/basemaps": "^5.7.2",
    "fastify": "^5.0.0",
    "maplibre-gl": "^5.0.0",
    "pmtiles": "^4.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
